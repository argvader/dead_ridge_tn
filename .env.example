# Copy this file to .env and fill in your real values.
# .env is git-ignored so your secrets stay out of the repo.

# Deepgram API key — used to transcribe/diarize session audio.
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# OpenAI API key — used by bin/gen-image.py to generate scene/location/hero art.
# Get one at https://platform.openai.com/api-keys (org must be verified for gpt-image-1).
OPENAI_API_KEY=

# AWS credentials for the async Deepgram flow (bin/deepgram_async.py).
# Least-privileged IAM user scoped to one bucket — see DEEPGRAM_AWS.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Private S3 bucket holding session audio + Deepgram results. One bucket is
# shared across campaigns; DEEPGRAM_PREFIX namespaces this repo's objects inside
# it so two campaigns recorded on the same date can't overwrite each other.
# Both override the defaults compiled into bin/deepgram_async.py.
DEEPGRAM_BUCKET=ttrpg-deepgram
DEEPGRAM_PREFIX=dead-ridge-tn
